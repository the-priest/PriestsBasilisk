# What the SOURCE distribution carries beyond the installed modules.
#
# The sdist is what a security-minded operator actually audits before running
# anything, so it ships the test suite and the installer too — "you can check
# it yourself" is only true if the checking material is in the tarball.

include LICENSE
include README.md
include llms.txt
include install.sh
include pyproject.toml

# The suite: 44 stdlib-only files, runnable straight out of the sdist.
recursive-include tests *.py

# Runtime art (also declared as package-data; belt and braces for the sdist).
recursive-include assets *.png *.svg *.jpg *.webp *.py

# Never ship build/VCS noise or a user's local state.
global-exclude *.py[cod]
global-exclude __pycache__
global-exclude .DS_Store
prune .git
prune dist
prune build
prune .venv
